# Application Environment
APP_ENV=local # local|staging|prod

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Database (matches docker-compose.yml settings)
POSTGRES_URL=postgresql://discourse_user:discourse_pass@localhost:5432/discourse_radar

# Source Control
ALLOWED_SOURCES=reddit.com,news.ycombinator.com,forums.example.com
REDDIT_COMPLIANCE_MODE=strict_api # api_only|mixed|strict_api

# Crawl Configuration
MAX_CRAWL_DEPTH=3
CRAWL_CONCURRENCY=5
CRAWL_INTERVAL_SECONDS=2

# Analysis Configuration
EMERGING_TOPIC_THRESHOLD=0.75

# GCP Configuration
GCLOUD_PROJECT=your_gcp_project_id
REGION=us-central1

# Service URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:8000
